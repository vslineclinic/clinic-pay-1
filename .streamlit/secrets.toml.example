# 예시 파일입니다. 실제 암호·키는 secrets.toml 또는 배포 Secrets에만 저장하세요.
# 이전 APP_PASSWORD 설정은 더 이상 로그인 권한을 부여하지 않습니다.
# 아이디/비밀번호는 아래 비공개 기록 시트의 '계정' 탭에서 관리합니다.
GOOGLE_API_KEY = ""
FILE_PASSWORD = ""  # 선택: 파일별 암호를 UI에 입력할 수도 있습니다.

# clinic-pay-1 개발 앱 전용 PostgreSQL. 운영 앱 DB나 지출앱 DB를 사용하지 않습니다.
# 실제 URI는 새 Streamlit 앱의 Secrets에만 저장하고 커밋하지 마세요.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# 아래 두 설정은 로컬 시험에서만 함께 사용합니다. Streamlit Cloud에 넣지 마세요.
# ALLOW_LOCAL_LEDGER = true
# LOCAL_LEDGER_PATH = "/absolute/local/path/receipt-ledger.sqlite"

# 필수: 계정 로그인용 읽기 인증. development.py는 이 시트에 기록/기기/계정을 쓰지 않습니다.
# 기존 app.py로 실행할 때만 운영 기록 저장에도 사용합니다.
# 반드시 [table] 설정보다 위의 최상위에 넣으세요. JSON 파일 전체를 작은따옴표 3개 안에 붙여넣습니다.
# 기록 시트에만 이 서비스 계정 이메일을 편집자로 추가합니다. 기존 7개 시트는 변경하지 않습니다.
# HISTORY_SHEET_ID = "REPLACE_WITH_HISTORY_SHEET_ID"
# HISTORY_SERVICE_ACCOUNT_JSON = '''
# {"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "...", "token_uri": "https://oauth2.googleapis.com/token"}
# '''

# 아래 설정이 없으면 기존 6지점·7파일 링크를 그대로 사용합니다.
# 추가하면 기본 지점과 병합하지 않고 설정 전체로 대체합니다. 빈 설정은 모든 지점을 숨깁니다.
# [clinic_daily_sheets]
# "예시점" = "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit"
# "전환예시점" = [["2026-06-12", "새 파일 URL"], ["", "옛 파일 URL"]]

# 기존 링크 연동에는 서비스 계정이 필요하지 않습니다. 실제 공유 권한을 유지합니다.
# 서비스 계정 경로를 따로 사용하는 경우에만 아래 전체 설정을 추가하세요.
# 이 설정이 있으면 인증 실패 시 링크 읽기로 우회하지 않습니다.
# [gcp_service_account]
# type = "service_account"
# project_id = "REPLACE_WITH_PROJECT_ID"
# private_key_id = "REPLACE_WITH_KEY_ID"
# private_key = "REPLACE_WITH_PEM_PRIVATE_KEY"
# client_email = "REPLACE_WITH_SERVICE_ACCOUNT_EMAIL"
# client_id = "REPLACE_WITH_CLIENT_ID"
# token_uri = "https://oauth2.googleapis.com/token"
